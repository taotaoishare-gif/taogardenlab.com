---
import Bi from './Bi.astro';
import { DOMAINS } from '../lib/domains';

interface Props {
  /** 'full' draws the intersection diagram; 'compact' is the home-page strip. */
  variant?: 'full' | 'compact';
}
const { variant = 'compact' } = Astro.props;
---

<div class:list={['domains', `domains--${variant}`]}>
  {
    variant === 'full' && (
      <svg class="venn" viewBox="0 0 340 250" role="img" aria-labelledby="venn-t venn-d">
        <title id="venn-t">Three overlapping domains</title>
        <desc id="venn-d">
          Culture and contemplation, intelligent environments, and human
          experience overlap; TAO Garden sits where all three meet.
        </desc>
        <circle cx="130" cy="95" r="78" />
        <circle cx="210" cy="95" r="78" />
        <circle cx="170" cy="160" r="78" />
        <text class="mark" x="96" y="70">天</text>
        <text class="mark" x="238" y="70">地</text>
        <text class="mark" x="167" y="205">人</text>
        <circle class="node" cx="170" cy="117" r="3.5" />
      </svg>
    )
  }

  <ol class="list">
    {
      DOMAINS.map((domain) => (
        <li>
          <p class="head">
            <span class="numeral">{domain.numeral}</span>
            <span class="mark" aria-hidden="true">
              {domain.mark}
            </span>
          </p>
          <h3>
            <Bi en={domain.name.en} zh={domain.name.zh} />
          </h3>
          <p class="q">
            <Bi en={domain.question.en} zh={domain.question.zh} />
          </p>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: clamp(2rem, 4vw, 3.5rem);
  }

  .list li {
    margin: 0;
    border-top: 1px solid var(--rule);
    padding-top: 1.1rem;
  }

  .head {
    display: flex;
    align-items: baseline;
    gap: 0.85rem;
    margin: 0 0 0.9rem;
  }

  .head .mark {
    font-family: var(--serif);
    font-size: 1.05rem;
    color: var(--ink-faint);
  }

  h3 {
    font-family: var(--sans);
    font-weight: 500;
    font-size: var(--size-h3);
    letter-spacing: 0.01em;
    margin-bottom: 0.7rem;
  }

  .q {
    margin: 0;
    max-width: 30ch;
    font-size: 1rem;
    line-height: 1.65;
    color: var(--ink-soft);
  }

  /* The intersection diagram. Strokes are the fifth permitted forest use. */
  .venn {
    width: min(22rem, 100%);
    height: auto;
    margin: 0 0 clamp(2.5rem, 5vh, 4rem);
    overflow: visible;
  }
  .venn circle {
    fill: none;
    stroke: var(--forest-soft);
    stroke-width: 1;
    opacity: 0.75;
  }
  .venn .node {
    fill: var(--forest);
    stroke: none;
    opacity: 1;
  }
  .venn .mark {
    font-family: var(--serif);
    font-size: 15px;
    fill: var(--ink-faint);
    text-anchor: middle;
  }

  @media (max-width: 44rem) {
    .list {
      gap: 2rem;
    }
  }
</style>
