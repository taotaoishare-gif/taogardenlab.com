---
import Bi from './Bi.astro';
import type { Bi as BiType } from '../lib/research';

/* A closed cycle: each stage feeds the next, and the last returns to the first.
   Used for the current study's system diagram (04).

   The return is drawn as a dashed path down the left gutter, so the loop reads
   as closed without forcing the text onto a circle. */

interface Props {
  stages: { name: BiType; detail?: BiType }[];
  returnLabel?: BiType;
}
const { stages, returnLabel } = Astro.props;
---

<figure class="loop">
  <div class="return" aria-hidden="true">
    <span class="return-label">
      {returnLabel && <Bi en={returnLabel.en} zh={returnLabel.zh} />}
    </span>
  </div>

  <ol class="stages">
    {
      stages.map((stage, i) => (
        <li class="stage">
          <span class="idx mono">{String(i + 1).padStart(2, '0')}</span>
          <div class="text">
            <p class="name">
              <Bi en={stage.name.en} zh={stage.name.zh} />
            </p>
            {stage.detail && (
              <p class="detail">
                <Bi en={stage.detail.en} zh={stage.detail.zh} />
              </p>
            )}
          </div>
        </li>
      ))
    }
  </ol>
</figure>

<style>
  .loop {
    position: relative;
    margin: 0;
    padding-left: 3.25rem;
  }

  .stages {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: none;
    border-left: 1px solid var(--line-2);
  }

  .stage {
    position: relative;
    margin: 0;
    padding: 0 0 1.5rem 1.6rem;
    display: flex;
    align-items: baseline;
    gap: 1rem;
  }

  .stage:last-child {
    padding-bottom: 0;
  }

  /* A node on the spine, and an arrowhead pointing into the next stage. */
  .stage::before {
    content: '';
    position: absolute;
    left: -3px;
    top: 0.5em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--bronze);
  }

  .idx {
    font-size: 0.625rem;
    letter-spacing: 0.16em;
    color: var(--text-dim);
    flex: none;
  }

  .name {
    margin: 0;
    font-family: var(--display);
    font-size: 1.2rem;
    line-height: 1.3;
    color: var(--mist);
  }

  .detail {
    margin: 0.3rem 0 0;
    font-family: var(--mono);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  /* The closing arc down the left gutter. */
  .return {
    position: absolute;
    left: 0;
    top: 0.6em;
    bottom: 0.6em;
    width: 2.25rem;
    border: 1px dashed var(--line-2);
    border-right: 0;
    border-radius: 1.25rem 0 0 1.25rem;
  }

  .return-label {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    background: var(--void);
    padding: 0.35rem 0.15rem;
    writing-mode: vertical-rl;
    font-family: var(--mono);
    font-size: 0.5625rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--bronze);
    white-space: nowrap;
  }

  @media (max-width: 40rem) {
    .loop {
      padding-left: 2.5rem;
    }
    .return {
      width: 1.5rem;
    }
    .stage {
      padding-left: 1.1rem;
      gap: 0.75rem;
    }
  }
</style>
