---
import Base from '../layouts/Base.astro';
import ThoughtMap from '../components/ThoughtMap.astro';
import LensVenn from '../components/LensVenn.astro';
import VideoLoop from '../components/VideoLoop.astro';
import Bi from '../components/Bi.astro';
import { getCollection } from 'astro:content';
import { SITE, iso } from '../lib/site';
import { UI } from '../lib/ui';

const experiments = await getCollection('experiments');
const byId = new Map(experiments.map((e) => [e.id, e]));
const featured = SITE.homeExperiments
  .map((id) => byId.get(id))
  .filter(Boolean) as typeof experiments;

---

<Base title="TAO Garden" theme="void">
  <!-- ══ 01 · MANIFESTO ═══════════════════════════════════════════ -->
  <section id="manifesto" class="screen s1" aria-labelledby="mark">
    <VideoLoop
      src="/video/threshold.mp4"
      poster="/image/threshold.jpg"
      ambient
      label="A bamboo grove in mist, generated and sounded by hand movement in Guqin Forest, one of the experiments on this site"
    />
    <div class="s1-scrim"></div>
    <div class="wrap s1-inner">
      <h1 id="mark" class="mark tracked">TAO Garden</h1>

      <p class="definition">
        <Bi en={SITE.definition.en} zh={SITE.definition.zh} />
      </p>

      <p class="question">
        <Bi en={SITE.thresholdQuestion.en} zh={SITE.thresholdQuestion.zh} />
      </p>

      <div class="actions">
        <a class="action" href="/demos/guqin-forest/">
          <Bi en={UI.tryExperiment.en} zh={UI.tryExperiment.zh} /> →
        </a>
      </div>
    </div>

    <a class="hint mono" href="#logic">
      <Bi en={UI.enterResearch.en} zh={UI.enterResearch.zh} />
      <span class="arrow" aria-hidden="true">↓</span>
    </a>
  </section>

  <!-- ══ 02 · LOGIC MAP ═══════════════════════════════════════════ -->
  <section id="logic" class="screen" aria-labelledby="logic-title">
    <div class="wrap">
      <h2 id="logic-title" class="stitle tracked">
        <span class="snum">02</span><Bi en="Questions" zh="问题" />
      </h2>
      <div class="ladder-holder">
        <ThoughtMap tone="dark" />
      </div>
    </div>
  </section>

  <!-- ══ 03 · THREE LENSES ════════════════════════════════════════ -->
  <section id="lenses" class="screen" aria-labelledby="lenses-title">
    <div class="wrap">
      <h2 id="lenses-title" class="stitle tracked">
        <span class="snum">03</span><Bi en="Worldview" zh="世界观" />
      </h2>
      <LensVenn />
    </div>
  </section>

  <!-- ══ 04 · PROTOTYPES ══════════════════════════════════════════ -->
  <section id="prototypes" class="screen screen--tight" aria-labelledby="proto-title">
    <div class="wrap">
      <h2 id="proto-title" class="stitle tracked">
        <span class="snum">04</span><Bi en="Prototypes" zh="原型" />
      </h2>

      <ol class="protos">
        {
          featured.map((exp, i) => (
            <li class:list={['proto', { lead: i === 0 }]}>
              <a class="cover" href={`/experiments/${exp.id}`}>
                <VideoLoop
                  src={exp.data.video}
                  poster={exp.data.thumb ?? exp.data.poster}
                  sound
                  label={`Recording of ${exp.data.name} running`}
                />
              </a>

              <h3 class="pname">
                <a href={`/experiments/${exp.id}`}>
                  <span class="en-only">{exp.data.name}</span>
                  <span class="zh-only">{exp.data.nameZh ?? exp.data.name}</span>
                </a>
              </h3>

              <p class="pq">{exp.data.title}</p>

              <p class="pmeta">
                <time datetime={iso(exp.data.date)}>{iso(exp.data.date)}</time>
                <span class="dot">·</span>
                {exp.data.lenses.slice(0, 3).join(' · ')}
              </p>

              {exp.data.demo && (
                <p class="ptry">
                  <a class="try-btn" href={exp.data.demo}>
                    <Bi en={UI.tryExperiment.en} zh={UI.tryExperiment.zh} /> →
                  </a>
                </p>
              )}
            </li>
          ))
        }
      </ol>

      <p class="all">
        <a class="view-more" href="/experiments">
          <Bi en="View more" zh="查看更多" />
        </a>
      </p>
    </div>
  </section>

  <!-- ══ 05 · ABOUT ═══════════════════════════════════════════════ -->
  <section id="about" class="screen screen--tight" aria-labelledby="about-title">
    <div class="wrap">
      <h2 id="about-title" class="stitle tracked">
        <span class="snum">05</span><Bi en="About" zh="关于" />
      </h2>

      <p class="about-lead">
        <Bi en="Why I am here" zh="我为何在此" />
      </p>

      <p class="about-body">
        <Bi
          en="I studied advertising, and spent years making things look like something — objects, exhibitions, cultural products for museums and gardens. A few years ago I started building instead of designing, which mostly meant learning to program badly and in public. The route here is not a straight line, and the detours are where the material came from."
          zh="我学的是广告，之后多年都在让东西「看起来像什么」——器物、展览、为博物馆与园林做的文创。几年前我开始动手造，而不只是设计，这主要意味着当众笨拙地学编程。走到这里的路不是直线，而素材恰恰来自那些弯路。"
        />
      </p>

      <p class="about-mail mono">
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
      </p>

      <p class="all">
        <a class="view-more" href="/about">
          <Bi en="Read the full account" zh="完整的自述" />
        </a>
      </p>
    </div>
  </section>
</Base>

<style>
  /* ── 01 Manifesto ──────────────────────────────────────────── */
  .s1 {
    min-height: 100svh;
  }

  .s1-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      radial-gradient(
        ellipse at 50% 44%,
        rgba(10, 9, 8, 0.72) 0%,
        rgba(10, 9, 8, 0.5) 46%,
        rgba(10, 9, 8, 0.24) 100%
      ),
      linear-gradient(
        to bottom,
        rgba(10, 9, 8, 0.72) 0%,
        rgba(10, 9, 8, 0.3) 42%,
        rgba(10, 9, 8, 0.88) 100%
      );
    pointer-events: none;
  }


  .s1-inner {
    position: relative;
    z-index: 2;
    text-align: center;
  }

  /* Largest thing on the site. */
  .mark {
    font-family: var(--display);
    font-weight: 300;
    font-size: clamp(2.6rem, 9vw, 6.5rem);
    letter-spacing: 0.24em;
    text-transform: uppercase;
    line-height: 1.08;
    color: var(--mist);
    margin: 0 auto clamp(2rem, 6vh, 3.5rem);
    text-indent: 0.24em; /* balance the trailing letter-space */
  }

  /* Then the definition. */
  .definition {
    font-family: var(--display);
    font-size: clamp(1.15rem, 2.1vw, 1.65rem);
    line-height: 1.5;
    max-width: 42ch;
    margin: 0 auto clamp(1.5rem, 4vh, 2.25rem);
    color: var(--mist-2);
  }

  /* Then the question — smaller than the definition, and the only line in
     the accent colour, so it reads as the point rather than as fine print. */
  .question {
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(1rem, 1.45vw, 1.2rem);
    line-height: 1.65;
    max-width: 52ch;
    margin: 0 auto clamp(2rem, 5.5vh, 3.25rem);
    color: var(--forest-glow);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.25rem;
    justify-content: center;
  }

  .action {
    font-family: var(--sans);
    font-size: var(--size-meta);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--text-clean);
    border: 1px solid color-mix(in srgb, var(--text-clean) 26%, transparent);
    padding: 0.95rem 1.75rem;
    transition:
      border-color var(--dur) var(--ease),
      background var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }

  .action:hover {
    color: var(--text-clean);
    border-color: var(--forest-glow);
    background: color-mix(in srgb, var(--forest-deep) 60%, transparent);
  }

  /* The way down, named rather than instructed. */
  .hint {
    position: absolute;
    left: 50%;
    bottom: clamp(1.5rem, 4vh, 2.5rem);
    transform: translateX(-50%);
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.6rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    text-decoration: none;
    color: color-mix(in srgb, var(--text-clean) 62%, transparent);
    z-index: 3;
    margin: 0;
    white-space: nowrap;
    transition: color var(--dur) var(--ease);
  }

  .hint:hover {
    color: var(--forest-glow);
  }

  .arrow {
    font-size: 0.9em;
    opacity: 0.8;
  }

  /* ── shared ────────────────────────────────────────────────── */
  /* Centred throughout — the front of the site is a sequence of held
     moments, not a column of reading. */
  .screen .wrap {
    text-align: center;
  }

  .numeral {
    margin: 0 0 0.8rem;
    color: var(--forest-glow);
  }

  /* Section label, in the reference's register: small, widely tracked, bronze.
     The number sits with its title as one unit, not floating above it. */
  .stitle {
    font-size: 0.625rem;
    letter-spacing: 0.3em;
    color: var(--text-dim);
    margin-bottom: clamp(1.75rem, 5vh, 3.5rem);
  }

  .snum {
    color: var(--bronze);
    margin-right: 1.1em;
  }

  .numeral {
    color: var(--bronze);
  }

  /* Blocks centre as blocks; multi-line text inside them stays left, because
     centred paragraphs are slower to read line after line. */
  .ladder-holder {
    max-width: 54rem;
    margin-inline: auto;
  }

  /* ── 04 Prototypes ─────────────────────────────────────────── */
  .protos {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: none;
    text-align: left;
  }

  /* The lead piece runs the full width; the other two share the row below. */
  .protos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2.5rem, 4vw, 3.5rem);
  }

  .proto {
    margin: 0;
  }

  .proto.lead {
    grid-column: 1 / -1;
  }

  .cover {
    display: block;
    background: var(--void-soft);
    overflow: hidden;
    text-decoration: none;
  }

  .cover :global(video) {
    aspect-ratio: 16 / 9;
    object-fit: cover;
    transition: opacity var(--dur) var(--ease);
  }

  .cover:hover :global(video) {
    opacity: 0.9;
  }

  .pname {
    margin: 1.15rem 0 0.4rem;
    font-family: var(--display);
    font-weight: 400;
    font-size: clamp(1.25rem, 2vw, 1.6rem);
    line-height: 1.25;
    letter-spacing: 0.02em;
  }

  .lead .pname {
    font-size: clamp(1.6rem, 2.8vw, 2.1rem);
  }

  .pname a {
    color: var(--mist);
    text-decoration: none;
  }

  .pname a:hover {
    color: var(--bronze);
  }

  .pq {
    margin: 0 0 0.6rem;
    font-family: var(--display);
    font-style: italic;
    font-size: 1.0625rem;
    line-height: 1.45;
    color: var(--mist-2);
    max-width: none;
  }

  .lead .pq {
    font-size: 1.2rem;
  }

  /* Keywords: quiet sans, small and widely tracked rather than monospaced —
     mono reads as machine output and this is just a label. */
  .pmeta {
    margin: 0 0 1.1rem;
    font-family: var(--sans);
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-dim);
    max-width: none;
  }

  .dot {
    margin-inline: 0.6em;
    opacity: 0.6;
  }

  .ptry {
    margin: 0;
    max-width: none;
  }

  .try-btn {
    display: inline-block;
    font-family: var(--sans);
    font-size: 0.625rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--mist);
    border: 1px solid var(--line-2);
    padding: 0.7rem 1.5rem;
    transition:
      border-color var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }

  .try-btn:hover {
    color: var(--bronze);
    border-color: var(--bronze);
  }

  .all {
    margin-top: clamp(2.5rem, 6vh, 4rem);
    max-width: none; /* the global 66ch measure would decentre it */
  }

  /* The reference's outlined button. */
  .view-more {
    display: inline-block;
    font-family: var(--sans);
    font-size: var(--size-meta);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--mist);
    border: 1px solid var(--line-2);
    padding: 1rem 3.5rem;
    transition:
      border-color var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }

  .view-more:hover {
    color: var(--bronze);
    border-color: var(--bronze);
  }

  /* ── 05 About ──────────────────────────────────────────────── */
  .about-lead {
    font-family: var(--display);
    font-weight: 300;
    font-size: clamp(1.7rem, 3.6vw, 2.6rem);
    line-height: 1.2;
    margin: 0 auto 1.75rem;
    max-width: none;
    color: var(--mist);
  }

  .about-body {
    max-width: 56ch;
    margin: 0 auto 2rem;
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--mist-2);
  }

  .about-mail {
    margin: 0 auto clamp(2rem, 5vh, 3rem);
    max-width: none;
  }

  .about-mail a {
    text-decoration: none;
    border-bottom: 1px solid var(--forest-soft);
    padding-bottom: 2px;
  }

  /* ── Narrow ────────────────────────────────────────────────── */
  @media (max-width: 52rem) {
    .protos {
      grid-template-columns: 1fr;
    }
    .mark {
      letter-spacing: 0.22em;
      text-indent: 0.22em;
    }
    .hint {
      display: none;
    }
  }
</style>
