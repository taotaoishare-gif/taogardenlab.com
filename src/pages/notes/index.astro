---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { iso } from '../../lib/site';

const [observations, readings, labNotes] = await Promise.all([
  getCollection('observations'),
  getCollection('readings'),
  getCollection('lab-notes'),
]);

type Row = {
  kind: 'observation' | 'reading' | 'lab';
  kindLabel: string;
  title: string;
  href: string;
  date: Date;
  meta?: string;
  body?: string[];
};

/* Observations are 30–150 words and make no claim, so they are shown in full
   here rather than hidden behind a link. They are the raw layer. */
const rows: Row[] = [
  ...observations.map((e) => ({
    kind: 'observation' as const,
    kindLabel: 'observation',
    title: e.data.title,
    href: `/notes/${e.id}/`,
    date: e.data.date,
    meta: e.data.place,
    body: e.body
      ?.trim()
      .split(/\n{2,}/)
      .map((p) => p.replace(/\n/g, ' ').trim())
      .filter(Boolean),
  })),
  ...readings.map((e) => ({
    kind: 'reading' as const,
    kindLabel: 'reading',
    title: e.data.title,
    href: `/notes/${e.id}/`,
    date: e.data.date,
    meta: `${e.data.author} · ${e.data.work}${e.data.year ? `, ${e.data.year}` : ''}`,
  })),
  ...labNotes.map((e) => ({
    kind: 'lab' as const,
    kindLabel: 'lab note',
    title: e.data.title,
    href: `/notes/${e.id}/`,
    date: e.data.date,
  })),
].sort((a, b) => b.date.getTime() - a.date.getTime());

const filters = [
  { id: 'all', label: 'All' },
  { id: 'observation', label: 'Observations' },
  { id: 'reading', label: 'Readings' },
  { id: 'lab', label: 'Lab notes' },
];
---

<Base
  title="Notes"
  description="Observations, reading notes and lab notes. Short things seen, positions taken on what was read, and records of what failed."
>
  <div class="page wrap">
    <header>
      <p class="label">Notes</p>
      <h1>Three kinds of small writing.</h1>
      <div class="key">
        <p>
          <strong>Observations</strong> are things I saw. They make no claim and
          carry no qualification, because a noticing that asserts nothing needs
          no hedge.
        </p>
        <p>
          <strong>Readings</strong> must contain a position — something I
          disagree with, or what it changed. <strong>Lab notes</strong> record a
          test that failed and what I changed as a result.
        </p>
        <p class="dim">There is no journal here, on purpose.</p>
      </div>
    </header>

    <nav class="filters" aria-label="Filter notes by kind">
      {
        filters.map((f, i) => (
          <button
            type="button"
            class:list={['chip', { 'is-on': i === 0 }]}
            data-kind={f.id}
            aria-pressed={i === 0 ? 'true' : 'false'}
          >
            {f.label}
          </button>
        ))
      }
    </nav>

    <ul class="list">
      {
        rows.map((row) => (
          <li class="item reveal" data-kind={row.kind}>
            <div class="item-meta">
              <time class="mono" datetime={iso(row.date)}>
                {iso(row.date)}
              </time>
              <span class="mono kind">{row.kindLabel}</span>
              {row.meta && <span class="mono place">{row.meta}</span>}
            </div>
            <h2>
              <a href={row.href}>{row.title}</a>
            </h2>
            {row.body && (
              <div class="obs">
                {row.body.map((p) => (
                  <p>{p}</p>
                ))}
              </div>
            )}
          </li>
        ))
      }
    </ul>

    <p class="mono empty" data-empty hidden>Nothing of that kind yet.</p>
  </div>
</Base>

<style>
  .page {
    padding-block: clamp(4rem, 10vh, 7rem) 0;
  }

  header {
    margin-bottom: clamp(3rem, 7vh, 4.5rem);
  }

  h1 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(1.7rem, 3.4vw, 2.4rem);
    letter-spacing: 0;
    margin-top: 1.25rem;
  }

  .key {
    margin-top: 1.75rem;
    max-width: 56ch;
  }

  .key p {
    font-size: 1rem;
    line-height: 1.7;
    margin-bottom: 1rem;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    margin-bottom: 3.5rem;
  }

  .chip {
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-faint);
    background: none;
    border: 1px solid var(--rule);
    padding: 0.5rem 0.9rem;
    cursor: pointer;
    transition:
      color var(--dur) var(--ease),
      border-color var(--dur) var(--ease);
  }

  .chip:hover {
    color: var(--ink);
  }

  .chip.is-on {
    color: var(--ink);
    border-color: var(--ink-faint);
  }

  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: none;
    border-top: 1px solid var(--rule);
  }

  .item {
    margin: 0;
    border-bottom: 1px solid var(--rule);
    padding: 2.25rem 0;
  }

  .item[hidden] {
    display: none;
  }

  .item-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.25rem;
    margin-bottom: 0.85rem;
  }

  .item h2 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 1.2rem;
    line-height: 1.45;
    letter-spacing: 0;
    max-width: 40ch;
  }

  .item h2 a {
    text-decoration: none;
  }

  .item h2 a:hover {
    text-decoration: underline;
    text-underline-offset: 0.22em;
    text-decoration-color: var(--ink-faint);
  }

  .obs {
    margin-top: 1.1rem;
    max-width: 52ch;
  }

  .obs p {
    font-size: 1.0625rem;
    line-height: 1.75;
    margin-bottom: 1rem;
  }

  .obs p:last-child {
    margin-bottom: 0;
  }

  .empty {
    padding-block: 3rem;
  }
</style>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('.chip');
  const items = document.querySelectorAll<HTMLElement>('.item');
  const empty = document.querySelector<HTMLElement>('[data-empty]');

  function apply(kind: string) {
    let shown = 0;
    items.forEach((item) => {
      const show = kind === 'all' || item.dataset.kind === kind;
      item.hidden = !show;
      if (show) shown++;
    });
    if (empty) empty.hidden = shown > 0;
    chips.forEach((chip) => {
      const on = chip.dataset.kind === kind;
      chip.classList.toggle('is-on', on);
      chip.setAttribute('aria-pressed', String(on));
    });
  }

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const kind = chip.dataset.kind || 'all';
      apply(kind);
      const url = new URL(window.location.href);
      if (kind === 'all') url.searchParams.delete('filter');
      else url.searchParams.set('filter', kind);
      history.replaceState(null, '', url);
    });
  });

  const initial = new URL(window.location.href).searchParams.get('filter');
  if (initial) apply(initial);
</script>
